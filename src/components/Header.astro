---
import { readFileSync } from 'fs';
import { parse } from 'yaml';

const siteData = parse(readFileSync('src/data/site.yaml', 'utf-8'));
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b border-cream">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/logo.png" alt={siteData.name} class="h-20 w-auto" />
    </a>

    <!-- Mobile menu button -->
    <button id="menu-toggle" class="md:hidden p-2 text-teal" aria-label="Toggle menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8">
      {siteData.nav.map((item: { label: string; href: string }) => (
        <a href={item.href} class="text-teal hover:text-salmon transition-colors font-medium">
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  <!-- Mobile nav -->
  <nav id="mobile-menu" class="hidden md:hidden bg-salmon/10 px-6 pb-4">
    {siteData.nav.map((item: { label: string; href: string }) => (
      <a href={item.href} class="block py-2 text-teal hover:text-salmon transition-colors font-medium">
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
