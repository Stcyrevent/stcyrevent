---
import { site } from '../lib/content';
const siteData = site();
---

<footer class="site">
  <div class="wrap">
    <div class="cols">
      <div>
        <p class="brand">{siteData.name}</p>
        <p>{siteData.footer_tagline}<br />{siteData.location}</p>
      </div>
      <div>
        <p class="h3">Pages</p>
        <ul>
          {siteData.nav.map((item: { label: string; href: string }) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/get-in-touch">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="h3">Contact</p>
        <ul>
          <li><a href={`mailto:${siteData.email}`}>{siteData.email}</a></li>
          {siteData.socials.map((s: { platform: string; url: string }) => <li><a href={s.url} target="_blank" rel="noopener">{s.platform}</a></li>)}
        </ul>
      </div>
    </div>
    <p class="copy">&copy; {new Date().getFullYear()} {siteData.name}</p>
  </div>
</footer>
