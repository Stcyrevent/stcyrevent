---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { readFileSync } from 'fs';
import { parse } from 'yaml';
import { getImage } from '../lib/images';

const siteData = parse(readFileSync('src/data/site.yaml', 'utf-8'));
const workData = parse(readFileSync('src/data/work.yaml', 'utf-8'));

// Map YAML image paths to optimized image metadata
const projects = (workData.projects ?? []).map((project: { image: string; caption: string; category: string }) => ({
  ...project,
  imageSrc: getImage(project.image),
}));

// Get unique categories
const categories = [...new Set(projects.filter((p: { imageSrc: ImageMetadata | null }) => p.imageSrc).map((p: { category: string }) => p.category))] as string[];
---

<Layout title="Work" description="Portfolio of events coordinated by St. Cyr Event Co. — corporate events, community events, conferences, and more.">
  <!-- Hero -->
  <section class="relative bg-banner-bg text-white py-20 md:py-28">
    <div class="absolute inset-0 bg-cover bg-center opacity-20" style="background-image: url('/images/services-hero.jpg');"></div>
    <div class="relative max-w-3xl mx-auto px-6 text-center">
      <h1 class="text-4xl md:text-5xl font-light mb-6">Work</h1>
      <p class="text-lg md:text-xl leading-relaxed opacity-90">{workData.intro}</p>
    </div>
  </section>

  <!-- Subheading -->
  <section class="pt-10 pb-4 md:pt-14 md:pb-6">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-light text-green mb-2 reveal">{workData.heading}</h2>
      <p class="text-teal/70 reveal">{workData.subtitle}</p>
    </div>
  </section>

  <!-- Category Filter -->
  <section class="pb-6">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-wrap gap-3 reveal" id="filter-buttons">
        <button
          class="filter-btn px-4 py-2 rounded-sm text-sm font-medium transition-colors bg-filter-btn-active-bg text-white"
          data-category="all"
        >
          All
        </button>
        {categories.map((cat) => (
          <button
            class="filter-btn px-4 py-2 rounded-sm text-sm font-medium transition-colors bg-filter-btn-bg text-teal hover:bg-filter-btn-active-bg hover:text-white"
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="pb-16 md:pb-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6" id="gallery">
        {projects.map((project: { image: string; caption: string; category: string; imageSrc: ImageMetadata | null }) => (
          project.imageSrc && (
            <div class="break-inside-avoid group gallery-item" data-category={project.category}>
              <button
                class="lightbox-trigger w-full text-left cursor-zoom-in"
                data-caption={project.caption}
                data-category={project.category}
              >
                <div class="overflow-hidden rounded bg-stone-100">
                  <Image
                    src={project.imageSrc}
                    alt={project.caption}
                    class="w-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                    width={600}
                  />
                </div>
                <div class="mt-2 px-1">
                  <p class="font-medium text-teal text-sm">{project.caption}</p>
                  <p class="text-xs text-teal/60">{project.category}</p>
                </div>
              </button>
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-section-alt-bg">
    <div class="max-w-4xl mx-auto px-6 text-center reveal">
      <p class="text-lg text-teal font-medium mb-4">{siteData.cta.work}</p>
      <a href="/get-in-touch" class="inline-block px-10 py-4 bg-btn-primary-bg text-white rounded-sm font-semibold text-lg hover:bg-btn-primary-hover transition-colors shadow-md">
        Get In Touch
      </a>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-[100] hidden bg-black/90 flex items-center justify-center" role="dialog" aria-modal="true">
    <button id="lightbox-close" class="absolute top-4 right-4 text-white/80 hover:text-white p-2 z-10" aria-label="Close lightbox">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <div class="max-w-5xl max-h-[90vh] mx-4 flex flex-col items-center">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded" />
      <div class="mt-4 text-center">
        <p id="lightbox-caption" class="text-white font-medium"></p>
        <p id="lightbox-category" class="text-white/60 text-sm mt-1"></p>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Category filtering
  const filterButtons = document.querySelectorAll('.filter-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const category = (btn as HTMLElement).dataset.category;

      // Update button styles
      filterButtons.forEach((b) => {
        b.classList.remove('bg-filter-btn-active-bg', 'text-white');
        b.classList.add('bg-filter-btn-bg', 'text-teal');
      });
      btn.classList.remove('bg-filter-btn-bg', 'text-teal');
      btn.classList.add('bg-filter-btn-active-bg', 'text-white');

      // Filter items
      galleryItems.forEach((item) => {
        const el = item as HTMLElement;
        if (category === 'all' || el.dataset.category === category) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });

  // Apply category filter from URL param (for links from services page)
  const urlParams = new URLSearchParams(window.location.search);
  const categoryParam = urlParams.get('category');
  if (categoryParam) {
    const matchBtn = Array.from(filterButtons).find(
      (btn) => (btn as HTMLElement).dataset.category === categoryParam
    );
    if (matchBtn) (matchBtn as HTMLElement).click();
  }

  // Lightbox
  const lightbox = document.getElementById('lightbox')!;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCaption = document.getElementById('lightbox-caption')!;
  const lightboxCategory = document.getElementById('lightbox-category')!;

  document.querySelectorAll('.lightbox-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const img = trigger.querySelector('img')!;
      // Use the full-size src (Astro may generate srcset)
      const srcset = img.getAttribute('srcset');
      let fullSrc = img.src;
      if (srcset) {
        const sources = srcset.split(',').map(s => s.trim());
        fullSrc = sources[sources.length - 1].split(' ')[0];
      }
      lightboxImg.src = fullSrc;
      lightboxImg.alt = (trigger as HTMLElement).dataset.caption || '';
      lightboxCaption.textContent = (trigger as HTMLElement).dataset.caption || '';
      lightboxCategory.textContent = (trigger as HTMLElement).dataset.category || '';
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    });
  });

  function closeLightbox() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
    lightboxImg.src = '';
  }

  document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
