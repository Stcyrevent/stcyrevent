---
import Layout from '../layouts/Layout.astro';
import QuoteWall from '../components/QuoteWall.astro';
import { Image, getImage } from 'astro:assets';
import { load, workPhotos, SERVICE_NAMES } from '../lib/content';

const data = load('work');
const photos = workPhotos();

// Filters: services first, then sectors — only the ones that have photos.
const serviceFilters = Object.keys(SERVICE_NAMES).filter((c) => photos.some((p) => p.service === c));
const sectorFilters = [...new Set(photos.map((p) => p.sector).filter(Boolean))].filter((s) => s !== 'Private');
const pad = (n: number) => String(n).padStart(2, '0');
// Large versions for the main viewer (loaded one at a time by the script below)
const large = await Promise.all(photos.map((p) => getImage({ src: p.src, width: 1800, format: 'webp' })));
---

<Layout title="Work" description="Event photos and past projects by St. Cyr Event Co. — client appreciation events, offsites, AGMs, trade shows and community events.">
  <div class="wrap page-head rv">
    <h1 class="d1">{data.heading}</h1>
    <p class="lg">{data.intro}</p>
  </div>

  <div class="wrap mode-grid" id="gallery">
    <div class="toolbar">
      <div class="filters" id="filters">
        <button class="on" data-f="all">All</button>
        {serviceFilters.map((c) => <button data-f={`svc:${c}`}>{SERVICE_NAMES[c]}</button>)}
        {sectorFilters.length > 0 && <span class="sep"></span>}
        {sectorFilters.map((s) => <button data-f={`sec:${s}`}>{s}</button>)}
      </div>
      <div class="view"><button class="on" data-mode="grid">Grid</button><button data-mode="viewer">Large</button></div>
    </div>

    <div class="viewer">
      <div class="stage" id="stage">
        {photos[0] && <img class="stage-img on" id="stageImg" src={large[0].src} alt={`${photos[0].title} — ${photos[0].client}`} />}
        <span class="count mono" id="count">01 / {pad(photos.length)}</span>
        <button class="nav-btn prev" data-step="-1" aria-label="Previous photo">←</button>
        <button class="nav-btn next" data-step="1" aria-label="Next photo">→</button>
      <div class="capbar">
        <p class="h3" id="capT">{photos[0]?.title}</p>
        <div class="meta"><span class="mono" id="capA">{photos[0]?.client}</span><span class="mono" id="capB">{photos[0]?.serviceName}</span></div>
      </div>
      </div>
      <div class="strip" id="strip">
        {photos.map((p, i) => (
          <button class={`th ${i === 0 ? 'on' : ''}`} data-i={i} aria-label={`Show ${p.title}`}>
            <Image src={p.src} alt="" width={280} />
          </button>
        ))}
      </div>
    </div>

    <div class="gridv" id="gridv">
      {photos.map((p, i) => (
        <button class="th" data-i={i} aria-label={`Open ${p.title}`}>
          <Image src={p.src} alt={`${p.title} — ${p.client}`} width={600} />
          <span class="gcap"><b>{p.title}</b><span>{[p.client, p.serviceName].filter(Boolean).join(' · ')}</span></span>
        </button>
      ))}
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="stats" data-stagger>
        {data.stats.map((st: any) => (
          <div class={`stat bg-${st.color}`}><span class="mono">{st.label}</span><span class="num" data-count={st.number}>{st.number}+</span></div>
        ))}
      </div>
    </div>
  </section>

  <QuoteWall />

  <script define:vars={{ meta: photos.map((p, i) => ({ t: p.title, c: p.client, s: p.service, n: p.serviceName, x: p.sector, u: large[i].src })) }}>
    const $ = (s) => document.querySelector(s);
    const $$ = (s) => [...document.querySelectorAll(s)];
    const img = $('#stageImg');
    const preload = (i) => { if (meta[i]) { const im = new Image(); im.src = meta[i].u; } };
    const strip = $$('#strip .th');
    const grid = $$('#gridv .th');
    let list = meta.map((_, i) => i);
    let cur = 0;
    const pad = (n) => String(n).padStart(2, '0');

    function show(k) {
      if (!list.length) return;
      cur = (k + list.length) % list.length;
      const idx = list[cur];
      img.classList.remove('on');
      const next = new Image();
      next.onload = () => { img.src = meta[idx].u; img.alt = meta[idx].t + ' — ' + meta[idx].c; img.classList.add('on'); };
      next.src = meta[idx].u;
      preload(list[(cur + 1) % list.length]);
      strip.forEach((t, i) => t.classList.toggle('on', i === idx));
      const m = meta[idx];
      $('#capT').textContent = m.t;
      $('#capA').textContent = m.c;
      $('#capB').textContent = m.n;
      $('#count').textContent = pad(cur + 1) + ' / ' + pad(list.length);
      const a = strip[idx], st = $('#strip');
      st.scrollTo({ left: a.offsetLeft - st.clientWidth / 2 + a.clientWidth / 2, behavior: 'smooth' });
    }

    function applyFilter(f) {
      list = meta.map((m, i) => i).filter((i) => {
        const m = meta[i];
        if (f === 'all') return true;
        if (f.startsWith('svc:')) return m.s === f.slice(4);
        if (f.startsWith('sec:')) return m.x === f.slice(4);
        return true;
      });
      const keep = new Set(list);
      strip.forEach((t, i) => t.classList.toggle('hide', !keep.has(i)));
      grid.forEach((t, i) => t.classList.toggle('hide', !keep.has(i)));
      $$('#filters button').forEach((b) => b.classList.toggle('on', b.dataset.f === f));
      show(0);
    }

    function setMode(m) {
      $('#gallery').classList.toggle('mode-grid', m === 'grid');
      $$('.view button').forEach((b) => b.classList.toggle('on', b.dataset.mode === m));
    }

    $('#filters').addEventListener('click', (e) => { const b = e.target.closest('[data-f]'); if (b) applyFilter(b.dataset.f); });
    $('#strip').addEventListener('click', (e) => { const t = e.target.closest('[data-i]'); if (t) show(list.indexOf(Number(t.dataset.i))); });
    $('#gridv').addEventListener('click', (e) => {
      const t = e.target.closest('[data-i]'); if (!t) return;
      setMode('viewer'); show(list.indexOf(Number(t.dataset.i)));
      $('#stage').scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
    $$('#stage [data-step]').forEach((b) => b.addEventListener('click', () => show(cur + Number(b.dataset.step))));
    $$('.view button').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode)));
    document.addEventListener('keydown', (e) => {
      if (e.target.closest && e.target.closest('input,textarea,select')) return;
      if (e.key === 'ArrowRight') show(cur + 1);
      if (e.key === 'ArrowLeft') show(cur - 1);
    });

    // Links from the Services page: /past-work?service=FS
    const svc = new URLSearchParams(location.search).get('service');
    if (svc && $(`#filters [data-f="svc:${svc.toUpperCase()}"]`)) applyFilter('svc:' + svc.toUpperCase());
  </script>
</Layout>
