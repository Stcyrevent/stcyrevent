---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { parse } from 'yaml';

const siteData = parse(readFileSync('src/data/site.yaml', 'utf-8'));
---

<Layout title="Get In Touch">
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <!-- Left: Text + Form -->
        <div>
          <h1 class="text-4xl md:text-5xl font-light text-teal mb-6">Contact</h1>
          <p class="text-lg leading-relaxed text-teal/80 mb-4">
            My freelance support offers more than an extra set of hands. It brings a fresh perspective, relevant experience, and a steady presence that helps events run smoothly.
          </p>
          <p class="text-lg leading-relaxed text-teal/80 mb-10">
            If you're looking for event support that's thoughtful, reliable, and genuinely collaborative, let's connect.
          </p>

          <form
            action="https://formspree.io/f/YOUR_FORM_ID"
            method="POST"
            class="space-y-5"
          >

            <div>
              <label for="name" class="block text-sm font-medium text-teal mb-1">Name *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 border border-green/40 rounded-sm bg-white text-teal focus:outline-none focus:border-green focus:ring-1 focus:ring-green transition-colors"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-teal mb-1">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-green/40 rounded-sm bg-white text-teal focus:outline-none focus:border-green focus:ring-1 focus:ring-green transition-colors"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-teal mb-1">Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                class="w-full px-4 py-3 border border-green/40 rounded-sm bg-white text-teal focus:outline-none focus:border-green focus:ring-1 focus:ring-green transition-colors resize-y"
              ></textarea>
            </div>

            <button
              type="submit"
              class="px-8 py-3 bg-salmon text-white rounded-sm font-medium hover:bg-salmon/90 transition-colors"
            >
              Send Message
            </button>
          </form>
        </div>

        <!-- Right: Image -->
        <div class="hidden md:block">
          <img
            src="/images/contact-hero.jpg"
            alt="Event coordination in action"
            class="w-full h-auto rounded object-cover aspect-[9/16] max-h-[700px]"
          />
        </div>
      </div>
    </div>
  </section>
</Layout>
