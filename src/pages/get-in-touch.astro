---
import Layout from '../layouts/Layout.astro';
import { site, services } from '../lib/content';

const s = site();
const c = s.contact;
const svc = services().services;
const checkColors = ['bg-yellow', 'bg-lime', 'bg-pink', 'bg-sky'];
const eventTypes = ['Offsite', 'Conference', 'Launch', 'Fundraiser or gala', 'Trade show', 'Community event', 'Other'];
---

<Layout title="Get in touch" description="Tell St. Cyr Event Co. about your event." closing={false}>
  <div class="wrap contact">
    <div class="rv">
      <h1 class="d1">{c.heading}</h1>
      <p class="lg">{c.intro}</p>
      <ul class="checks" data-stagger>
        {c.checklist.map((item: string, i: number) => (
          <li>
            <span class={`ck ${checkColors[i % checkColors.length]}`}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10" /></svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <form class="form rv" id="contact-form" action={c.formspree_url} method="POST">
      <div><label for="f-name">Name</label><input id="f-name" name="name" required autocomplete="name" /></div>
      <div><label for="f-email">Email</label><input id="f-email" type="email" name="email" required autocomplete="email" /></div>
      <div class="full"><label for="f-msg">Message</label><textarea id="f-msg" name="message" placeholder="A few lines about your event"></textarea></div>

      <details class="full more">
        <summary>Add event details <i>optional</i></summary>
        <div class="more-grid">
          <div>
            <label for="f-type">Event type</label>
            <select id="f-type" name="event_type">
              <option value="">Select</option>
              {eventTypes.map((t) => <option>{t}</option>)}
            </select>
          </div>
          <div><label for="f-date">Event date</label><input id="f-date" type="date" name="event_date" /></div>
          <div class="full">
            <label>Support needed</label>
            <div class="chips">
              {svc.map((x: any) => (
                <>
                  <input type="checkbox" id={`f-s-${x.code}`} name="support" value={x.title} />
                  <label for={`f-s-${x.code}`}>{x.title}</label>
                </>
              ))}
              <input type="checkbox" id="f-s-unsure" name="support" value="Not sure yet" />
              <label for="f-s-unsure">Not sure</label>
            </div>
          </div>
          <div class="full"><label for="f-more">Anything else I should know?</label><textarea id="f-more" name="details" placeholder="Guest count, budget, venue, goals…"></textarea></div>
        </div>
      </details>

      <div class="full"><button class="btn" type="submit" id="submit-btn">Send</button></div>
      <p class="msg bg-lime" id="form-success" hidden>{c.success}</p>
      <p class="msg bg-pink" id="form-error" hidden>Something went wrong. Please try again or email {s.email}.</p>
    </form>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const ok = document.getElementById('form-success')!;
    const err = document.getElementById('form-error')!;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Sending…';
      err.hidden = true;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error();
        form.querySelectorAll('div, details').forEach((el) => ((el as HTMLElement).hidden = true));
        ok.hidden = false;
      } catch {
        err.hidden = false;
        btn.disabled = false;
        btn.textContent = 'Send';
      }
    });
  </script>
</Layout>
