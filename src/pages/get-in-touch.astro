---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { readFileSync } from 'fs';
import { parse } from 'yaml';
import { getImage } from '../lib/images';

const siteData = parse(readFileSync('src/data/site.yaml', 'utf-8'));

const contactHero = getImage(siteData.contact.photo);
---

<Layout title="Get In Touch" description="Contact St. Cyr Event Co. for freelance event coordination, project management, and marketing support.">
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <!-- Left: Text + Form -->
        <div class="reveal">
          <h1 class="text-4xl md:text-5xl font-light text-teal mb-6">{siteData.contact.heading}</h1>
          <p class="text-lg leading-relaxed text-teal/80 mb-4">{siteData.contact.intro}</p>
          <p class="text-lg leading-relaxed text-teal/80 mb-10">{siteData.contact.closing}</p>

          <form
            id="contact-form"
            action="https://formspree.io/f/mlgpynvq"
            method="POST"
            class="space-y-5"
          >

            <div>
              <label for="name" class="block text-sm font-medium text-teal mb-1">Name *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 border border-green/40 rounded-sm bg-white text-teal focus:outline-none focus:border-green focus:ring-1 focus:ring-green transition-colors"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-teal mb-1">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-green/40 rounded-sm bg-white text-teal focus:outline-none focus:border-green focus:ring-1 focus:ring-green transition-colors"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-teal mb-1">Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                class="w-full px-4 py-3 border border-green/40 rounded-sm bg-white text-teal focus:outline-none focus:border-green focus:ring-1 focus:ring-green transition-colors resize-y"
              ></textarea>
            </div>

            <button
              type="submit"
              id="submit-btn"
              class="px-10 py-4 bg-btn-primary-bg text-white rounded-sm font-semibold text-lg hover:bg-btn-primary-hover transition-colors shadow-md"
            >
              Send Message
            </button>
          </form>

          <!-- Success Message -->
          <div id="form-success" class="hidden py-8 text-center">
            <p class="text-2xl font-light text-teal mb-2">Thank you!</p>
            <p class="text-lg text-teal/80">Your message has been sent. I'll be in touch soon.</p>
          </div>

          <!-- Error Message -->
          <div id="form-error" class="hidden py-4 px-5 bg-red-50 border border-red-200 rounded-sm">
            <p class="text-red-700">Something went wrong. Please try again or email directly at <a href={`mailto:${siteData.email}`} class="underline">{siteData.email}</a>.</p>
          </div>
        </div>

        <!-- Right: Image -->
        {contactHero && (
          <div class="hidden md:block reveal">
            <Image
              src={contactHero}
              alt={siteData.contact.photoAlt || ''}
              class="w-full h-auto rounded object-cover aspect-[9/16] max-h-[700px]"
              width={600}
            />
          </div>
        )}
      </div>
    </div>
  </section>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success')!;
  const errorMsg = document.getElementById('form-error')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    errorMsg.classList.add('hidden');

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.classList.add('hidden');
        successMsg.classList.remove('hidden');
      } else {
        throw new Error();
      }
    } catch {
      errorMsg.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Message';
    }
  });
</script>
</Layout>
