---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { readFileSync } from 'fs';
import { parse } from 'yaml';

const siteData = parse(readFileSync('src/data/site.yaml', 'utf-8'));
const servicesData = parse(readFileSync('src/data/services.yaml', 'utf-8'));
const testimonialsData = parse(readFileSync('src/data/testimonials.yaml', 'utf-8'));

const headshot = (await import('../assets/images/headshot.jpg')).default;
const allLogos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/logos/*.{png,jpg,jpeg,gif,webp,svg}',
  { eager: true }
);
const logoEntries = Object.entries(allLogos)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({
    src: mod.default,
    alt: path.split('/').pop()!.replace(/\.[^.]+$/, '').replace(/[-_+]/g, ' '),
  }));
---

<Layout title="Home">
  <!-- Hero -->
  <section class="bg-cream/40 py-10 md:py-14">
    <div class="max-w-3xl mx-auto px-6 text-center reveal">
      <img src="/images/logo.png" alt={siteData.hero.headline} class="h-32 md:h-44 w-auto mx-auto mb-6" />
      <p class="text-lg md:text-xl text-teal/80 leading-relaxed">
        {siteData.hero.tagline}
      </p>
      <a href="/get-in-touch" class="inline-block mt-8 px-10 py-4 bg-salmon text-white rounded-sm font-semibold text-lg hover:bg-salmon/85 transition-colors shadow-md">
        Get In Touch
      </a>
    </div>
  </section>

  <!-- About -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-5 gap-12 items-center">
        <div class="md:col-span-3 space-y-6 reveal">
          <p class="text-lg leading-relaxed">{siteData.about.intro}</p>
          <p class="text-lg leading-relaxed italic text-teal/70">{siteData.about.story}</p>
          <p class="text-lg leading-relaxed">{siteData.about.experience}</p>
        </div>
        <div class="md:col-span-2 flex justify-center reveal">
          <div class="ring-4 ring-green/50 ring-offset-4 rounded-full">
          <Image
            src={headshot}
            alt="Kendra St. Cyr"
            class="w-56 h-56 md:w-64 md:h-64 rounded-full object-cover shadow-lg"
            width={256}
            height={256}
          />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Preview -->
  <section class="bg-green/10 py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-baseline justify-between mb-12 reveal">
        <h2 class="text-3xl font-light text-teal">Services</h2>
        <a href="/services" class="text-salmon hover:text-salmon/80 font-semibold transition-colors">
          View all &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {servicesData.services.map((service: { title: string; description: string }, i: number) => (
          <a href={`/services#service-${i}`} class="group p-6 bg-white border-l-4 border-green hover:shadow-lg hover:border-salmon transition-all reveal">
            <h3 class="font-semibold text-teal group-hover:text-salmon transition-colors mb-2">
              {service.title}
            </h3>
            <p class="text-sm text-teal/70">{service.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl font-light text-teal mb-12 text-center reveal">What People Say</h2>
      <div id="testimonial-carousel" class="relative reveal">
        {testimonialsData.testimonials.map((t: { quote: string; name: string; title: string; company: string }, i: number) => (
          <div class:list={['testimonial-slide', { hidden: i !== 0 }]} data-index={i}>
            <blockquote class="border-l-4 border-salmon pl-6 md:pl-8">
              <p class="text-teal/80 leading-relaxed mb-6">{t.quote}</p>
              <footer class="font-semibold text-teal">
                {t.name}
                <span class="block text-sm font-normal text-teal/60">{t.title}, {t.company}</span>
              </footer>
            </blockquote>
          </div>
        ))}
        <div class="flex items-center justify-center gap-4 mt-8">
          <button id="prev-testimonial" class="p-2 text-teal/50 hover:text-salmon transition-colors" aria-label="Previous testimonial">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <span id="testimonial-counter" class="text-sm text-teal/50">1 / {testimonialsData.testimonials.length}</span>
          <button id="next-testimonial" class="p-2 text-teal/50 hover:text-salmon transition-colors" aria-label="Next testimonial">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="bg-salmon/10 py-10 mb-0 reveal">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <p class="text-lg text-teal font-medium mb-4">Ready to bring your next event to life?</p>
      <a href="/get-in-touch" class="inline-block px-10 py-4 bg-salmon text-white rounded-sm font-semibold text-lg hover:bg-salmon/85 transition-colors shadow-md">
        Get In Touch
      </a>
    </div>
  </section>

  <script>
    const slides = document.querySelectorAll('.testimonial-slide');
    const counter = document.getElementById('testimonial-counter');
    const total = slides.length;
    let current = 0;
    let autoTimer: ReturnType<typeof setInterval>;

    function show(index: number) {
      slides.forEach(s => s.classList.add('hidden'));
      slides[index].classList.remove('hidden');
      if (counter) counter.textContent = `${index + 1} / ${total}`;
    }

    function resetAuto() {
      clearInterval(autoTimer);
      autoTimer = setInterval(() => {
        current = (current + 1) % total;
        show(current);
      }, 8000);
    }

    document.getElementById('prev-testimonial')?.addEventListener('click', () => {
      current = (current - 1 + total) % total;
      show(current);
      resetAuto();
    });

    document.getElementById('next-testimonial')?.addEventListener('click', () => {
      current = (current + 1) % total;
      show(current);
      resetAuto();
    });

    resetAuto();
  </script>

  <!-- Organizations -->
  <section class="bg-white pt-16 pb-16 md:pt-24 md:pb-24">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl font-light text-teal mb-4 reveal">{siteData.organizations.heading}</h2>
      <p class="text-teal/70 mb-10 reveal">{siteData.organizations.description}</p>
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12 reveal">
        {logoEntries.map((logo) => (
          <Image
            src={logo.src}
            alt={logo.alt}
            class="h-16 md:h-20 w-auto object-contain"
            height={80}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
