---
import Layout from '../layouts/Layout.astro';
import QuoteWall from '../components/QuoteWall.astro';
import { Image } from 'astro:assets';
import { site, services, logoWall } from '../lib/content';
import feature from '../assets/images/home/feature.jpg';
import headshot from '../assets/images/headshot.jpg';

const s = site();
const svc = services().services;
const logos = logoWall();
const words: string[] = s.hero.rotating_words ?? [];

// Simple line icons for each service, by service code
const icons: Record<string, string> = {
  FS: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  PE: '<path d="M10 6h11M10 12h11M10 18h11"/><path d="m3 6 1.5 1.5L7 5M3 12l1.5 1.5L7 11"/><circle cx="5" cy="18" r="1.5"/>',
  OS: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  VC: '<rect x="2" y="5" width="14" height="14" rx="2"/><path d="m16 10 6-4v12l-6-4"/>',
};
---

<Layout title="Home">
  <!-- Hero -->
  <section class="hero-type" style="--c: var(--yellow)">
    <div class="rv">
      <h1 class="hero-line">
        <span>{s.hero.headline}</span><br />{s.hero.lead_in}<br />
        <span class="swap"><span class="word">{words[0]}</span></span>
      </h1>
      <p class="lg">{s.hero.tagline}</p>
      <div class="ctas">
        <a class="btn" href="/get-in-touch">{s.cta_label}</a>
        <a class="btn light" href="/past-work">{s.hero.secondary_button}</a>
      </div>
    </div>
  </section>
  <script define:vars={{ words }}>
    // Rotates the event type in the hero headline. The background colour
    // drifts through the palette in step (colours come from theme.css).
    const colors = ['var(--yellow)', 'var(--pink)', 'var(--lime)', 'var(--sky)'];
    const hero = document.querySelector('.hero-type');
    const box = document.querySelector('.hero-type .swap');
    if (hero && box && words.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let i = 0;
      setInterval(() => {
        i = (i + 1) % words.length;
        hero.style.setProperty('--c', colors[i % colors.length]);
        const cur = box.querySelector('.word');
        const next = document.createElement('span');
        next.className = 'word pre';
        next.textContent = words[i];
        cur.classList.add('out');
        setTimeout(() => {
          cur.remove();
          box.appendChild(next);
          requestAnimationFrame(() => requestAnimationFrame(() => next.classList.remove('pre')));
        }, 450);
      }, 2200);
    }
  </script>

  <!-- Logo wall -->
  <section class="section">
    <div class="wrap">
      <div class="head rv"><h2 class="h2">{s.logo_wall.heading}<br /><span class="soft">{s.logo_wall.heading_soft}</span></h2></div>
      <div class="logos" data-stagger>
        {logos.map((l) => (
          <div class="t"><Image src={l.src} alt={l.name} width={l.w * 2} style={`width:${l.w}px;height:${l.h}px`} /></div>
        ))}
        <div class="feat">
          <Image src={feature} alt="" width={700} />
          <div>
            <div class="num" data-count={s.logo_wall.feature_number}>{s.logo_wall.feature_number}+</div>
            <p>{s.logo_wall.feature_label}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section" id="about">
    <div class="wrap about">
      <Image class="headshot rv" src={headshot} alt="Kendra St. Cyr" width={900} />
      <div class="rv">
        <h2 class="h2">{s.about.heading}</h2>
        <p class="lg">{s.about.intro}</p>
        <p class="body" style="margin-top:16px">{s.about.experience}</p>
        <p class="body">{s.about.story}</p>
      </div>
    </div>
  </section>

  <!-- Services preview -->
  <section class="section">
    <div class="wrap">
      <div class="head rv"><h2 class="h2">{s.services_preview.heading}</h2><p class="body">{s.services_preview.subheading}</p></div>
      <div class="divided" data-stagger>
        {svc.map((x: any) => (
          <div>
            <span class={`icon bg-${x.color}`}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[x.code] ?? ''} />
            </span>
            <p class="h3">{x.title}</p>
            <p class="body">{x.short}</p>
            <a class="link" href={`/services#${x.code.toLowerCase()}`}>Details</a>
          </div>
        ))}
      </div>
      <p class="after">Not sure which fits? <a href="/services">Find your fit</a></p>
    </div>
  </section>

  <!-- Process -->
  <section class="section bg-yellow">
    <div class="wrap">
      <div class="head rv"><h2 class="h2">{s.process.heading}</h2></div>
      <div class="steps" data-stagger>
        {s.process.steps.map((step: any, i: number) => (
          <div>
            <div class="crop"><span class="num">{String(i + 1).padStart(2, '0')}</span></div>
            <p class="h3">{step.title}</p>
            <p class="body">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <QuoteWall />
</Layout>
