---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found">
  <section class="py-24 md:py-32 text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h1 class="text-5xl font-light text-teal mb-4">404</h1>
      <p class="text-xl text-teal/70 mb-8">Oops! That page can't be found.</p>
      <a href="/" class="inline-block px-8 py-3 bg-salmon text-white rounded-sm font-medium hover:bg-salmon/90 transition-colors">
        Back to Home
      </a>
    </div>
  </section>
</Layout>
