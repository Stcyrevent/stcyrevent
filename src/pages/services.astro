---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { parse } from 'yaml';

const servicesData = parse(readFileSync('src/data/services.yaml', 'utf-8'));
---

<Layout title="Services">
  <!-- Hero -->
  <section class="relative bg-teal text-white py-20 md:py-28">
    <div class="absolute inset-0 bg-cover bg-center opacity-20" style="background-image: url('/images/services-hero.jpg');"></div>
    <div class="relative max-w-3xl mx-auto px-6 text-center">
      <h1 class="text-4xl md:text-5xl font-light mb-6">Services</h1>
      <p class="text-lg md:text-xl leading-relaxed opacity-90">{servicesData.intro}</p>
    </div>
  </section>

  <!-- Services List -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <p class="text-lg text-teal/80 mb-12">{servicesData.subtitle}</p>

      <div class="space-y-6">
        {servicesData.services.map((service: { title: string; description: string; items: string[] }, index: number) => (
          <details class="group border-l-4 border-green bg-white shadow-sm" open={index === 0}>
            <summary class="flex items-center justify-between cursor-pointer p-6 bg-green/10 hover:bg-green/20 transition-colors">
              <h2 class="text-xl font-semibold text-teal">{service.title}</h2>
              <svg class="w-5 h-5 text-green transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="p-6 pt-4">
              <p class="text-teal/70 italic mb-4">{service.description}</p>
              <ul class="space-y-2">
                {service.items.map((item: string) => (
                  <li class="flex items-start gap-2">
                    <span class="text-salmon mt-1">&#x2022;</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        ))}
      </div>

      <!-- Add-on services -->
      <blockquote class="mt-12 border-l-4 border-salmon pl-6 py-4 text-teal/80 italic bg-salmon/5">
        {servicesData.addons}
      </blockquote>
    </div>
  </section>
</Layout>
