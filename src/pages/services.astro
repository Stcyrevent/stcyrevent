---
import Layout from '../layouts/Layout.astro';
import { services, load } from '../lib/content';

const data = services();
const faq = load('faq');
const addons = data.addons;
const tileColors = ['bg-yellow', 'bg-lime', 'bg-pink', 'bg-sky'];
---

<Layout title="Services" description="Event coordination, pre-event support, on-site management and virtual event consultation by St. Cyr Event Co.">
  <div class="wrap page-head rv" style="padding-bottom:40px">
    <h1 class="d1">{data.heading}</h1>
    <p class="lg">{data.intro}</p>
  </div>

  <!-- Which sounds like you? -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="picks" data-stagger>
        {data.services.map((x: any) => (
          <a class={`pick bg-${x.color}`} href={`#${x.code.toLowerCase()}`}>
            <blockquote>"{x.client_voice}"</blockquote>
            <div class="sig" aria-label={`Involvement ${x.level} of 4`}>
              {[1, 2, 3, 4].map((n) => <i class={n <= x.level ? 'on' : ''}></i>)}
            </div>
            <span class="link">{x.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Service panels (stack as you scroll) -->
  <section class="section" style="padding-top:24px">
    <div class="wrap">
      {data.services.map((x: any, i: number) => (
        <div class={`panel bg-${x.color}`} id={x.code.toLowerCase()}>
          <div>
            <div class="crop"><span class="num">{String(i + 1).padStart(2, '0')}</span></div>
            <h2 class="h2">{x.title}</h2>
            <p class="lg">{x.for}</p>
          </div>
          <div>
            <ul>{x.items.map((it: string) => <li>{it}</li>)}</ul>
            <div class="out"><p>{x.outcome}</p><a class="link" href={`/past-work?service=${x.code}`}>See examples</a></div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Add-ons -->
  <section class="section addon-sec bg-ink">
    <div class="wrap">
      <div class="head rv">
        <h2 class="h2" style="color:#fff">{addons.heading} <span style="color:#9a9a9a">{addons.heading_soft}</span></h2>
        <p class="body" style="color:#9a9a9a">{addons.text}</p>
      </div>
    </div>
    <div class="marquee rv">
      <div class="track">
        {[...addons.items, ...addons.items, ...addons.items, ...addons.items].map((t: string, i: number) => {
          const dup = i >= addons.items.length;
          return <span class={`tile ${tileColors[i % tileColors.length]} ${dup ? 'dup' : ''}`} aria-hidden={dup ? 'true' : undefined}>{t}</span>;
        })}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="wrap faq">
      <div class="head rv"><h2 class="h2">{faq.heading}</h2></div>
      <div class="rv">
        {faq.questions.map((f: any) => (
          <details><summary>{f.q}</summary><p class="body">{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>
</Layout>
